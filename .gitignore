# Dependencies: installed with bun install
node_modules/

# Build: generated output
dist/
build/
coverage/

# Environment: secrets, never commit keys (Groq, Anthropic, Culqi, DB)
.env
.env.*
!.env.example
*.pem
*.key

# Logs: runtime and package manager logs
*.log
npm-debug.log*
yarn-debug.log*
bun-debug.log*

# System and editors: local machine files
.DS_Store
Thumbs.db
.idea/
*.swp

# Temporary: scratch artifacts
*.trace
*.zip
*.tar.gz
*.tgz

# Package managers: this project uses Bun, bun.lock IS committed
package-lock.json
yarn.lock
pnpm-lock.yaml

# Agent tools: temporary, not part of the history
.atl
.claude/worktrees/
