# Database: PostgreSQL credentials
POSTGRES_USER=kilo_app
POSTGRES_PASSWORD=
POSTGRES_DB=kilo_dev

# Ports: host ports for the database, the API and the docs
DB_HOST_PORT=5433
API_HOST_PORT=3001
DOCS_HOST_PORT=4321

# Access: code a restaurant must send to register (empty = open registration)
INVITE_CODE=

# Voice: Groq transcribes; Claude extracts when its key is set, otherwise gpt-oss on Groq (no Groq key = voice off)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
