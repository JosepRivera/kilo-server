# Database: PostgreSQL credentials
POSTGRES_USER=kilo_app
POSTGRES_PASSWORD=
POSTGRES_DB=kilo_dev

# Ports: host ports for the database, the API and the docs
DB_HOST_PORT=5433
API_HOST_PORT=3001
DOCS_HOST_PORT=4321

# Connection: database URL for running the API on the host
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_HOST_PORT}/${POSTGRES_DB}
