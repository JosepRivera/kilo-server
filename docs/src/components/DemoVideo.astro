---
interface Props {
	name: string;
	label: string;
}

const { name, label } = Astro.props;
---

<figure class="demo-video">
	<video autoplay loop muted playsinline controls aria-label={label}>
		<source src={`/videos/${name}.webm`} type="video/webm" />
		<source src={`/videos/${name}.mp4`} type="video/mp4" />
	</video>
	<figcaption><slot /></figcaption>
</figure>

<style>
	.demo-video {
		margin: 1.5rem auto;
		max-width: 20rem;
	}

	.demo-video video {
		width: 100%;
		display: block;
		border-radius: 0.75rem;
	}

	.demo-video figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
