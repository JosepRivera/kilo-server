{
	"name": "kilo-server",
	"version": "0.1.0",
	"scripts": {
		"dev": "docker compose up --build --watch",
		"stop": "docker compose down",
		"clean": "docker compose down --volumes --rmi local --remove-orphans",
		"docker:start": "bun run src/db/migrate.ts && bun run src/index.ts",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"@elysiajs/openapi": "^1.4.16",
		"drizzle-orm": "1.0.0-rc.5-5935859",
		"elysia": "1.4.30"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.3",
		"drizzle-kit": "1.0.0-rc.5-5935859",
		"typescript": "^7.0.2"
	},
	"module": "src/index.ts",
	"private": true
}
