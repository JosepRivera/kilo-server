{
	"name": "kilo-server",
	"version": "0.1.0",
	"scripts": {
		"dev": "docker compose up --build --watch",
		"stop": "docker compose down",
		"clean": "docker compose down --volumes --rmi local --remove-orphans",
		"docker:start": "bun run src/db/migrate.ts && bun run src/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:check": "drizzle-kit check",
		"check": "biome check . && tsc --noEmit",
		"test": "docker compose up --detach --wait database && bun test",
		"db:seed-demo": "bun run scripts/seed-demo.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.8.0",
		"@elysiajs/openapi": "^1.4.17",
		"drizzle-orm": "1.0.0-rc.5",
		"elysia": "1.4.32",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/bun": "^1.4.4",
		"drizzle-kit": "1.0.0-rc.5",
		"typescript": "^7.0.2"
	},
	"module": "src/index.ts",
	"private": true
}
